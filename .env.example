# From @BotFather
TELEGRAM_BOT_TOKEN=

# Starknet mainnet RPC. Production uses the Alchemy key from the portfolio project
# (Railway variable, not committed). Cartridge is a public fallback.
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet

# Optional WebSocket for faster swap alerts. If omitted or it fails, the bot polls HTTP.
STARKNET_WS_URL=

# Optional override. Defaults to ./data/brother-eli.db
# DATABASE_PATH=./data/brother-eli.db
