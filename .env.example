# From @BotFather
TELEGRAM_BOT_TOKEN=

# Starknet mainnet RPC. Comma-separate several Alchemy (or other) URLs for
# automatic failover on 429 / monthly capacity. Production sets this in Railway.
# STARKNET_RPC_URLS= is an optional alias for the same list.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/KEY

# Optional WebSocket for faster swap alerts. When set and connected, HTTP only
# runs a slow backup poll (see POLL_BACKUP_MS). If omitted or it fails, the bot
# polls HTTP at POLL_INTERVAL_MS.
STARKNET_WS_URL=

# Optional. HTTP getEvents interval when WebSocket is down (ms, default 5000).
# POLL_INTERVAL_MS=5000

# Optional. Slow HTTP backup while WebSocket is healthy (ms, default 30000).
# POLL_BACKUP_MS=30000

# Optional. Without this, /chart All is capped at ~180 days (Gecko public API).
# Analyst+ CoinGecko key unlocks full pool history like the GeckoTerminal website.
# COINGECKO_API_KEY=

# Optional override for SLAY all-time high (default 0.002019 in code).
# SLAY_ATH_USD=0.002019

# Optional. Origin for /eli NFT images, metadata, and deep links.
# ELI_SITE_ORIGIN=https://brothereli.com

# Optional. Marketplace indexer proxy for NFT list/sold alerts (default {ELI_SITE_ORIGIN}/api/eli-marketplace).
# MARKETPLACE_API_URL=https://brothereli.com/api/eli-marketplace

# Optional. How often to poll marketplace activity (ms, default 15000).
# NFT_ACTIVITY_POLL_MS=15000

# Optional. Your Telegram user id(s). Owners see how many groups the bot is in
# (count only — other groups' names/settings stay hidden unless you are admin).
# BOT_OWNER_IDS=123456789

# --- Brother Eli wheel of fortune (test bot) ---
# WHEEL_ENABLED=1
# WHEEL_TEST_CHAT_ID=-100xxxxxxxxxx
# Dry-run by default (animation + edit/pin, no chain send). Set WHEEL_LIVE=1 to pay.
# WHEEL_LIVE=0
# Weighted prizes among winning spins (prize:weight). Must read as % (sums to 100).
# WHEEL_PRIZE_WEIGHTS=8:53,88:30,888:15,8888:2
# Tip wallet — only needed when WHEEL_LIVE=1 (Railway secrets, never commit).
# SLAY_TIP_ACCOUNT_ADDRESS=
# SLAY_TIP_PRIVATE_KEY=
# Optional override for Eli NFT collection.
# ELI_COLLECTION=0x062969ccea9a6740d66f2c9aab3f1466f75c5fe21f28355082e20ace7340a289
