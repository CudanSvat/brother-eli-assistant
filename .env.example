# From @BotFather
TELEGRAM_BOT_TOKEN=

# Starknet mainnet RPC. Comma-separate several Alchemy (or other) URLs for
# automatic failover on 429 / monthly capacity. Production sets this in Railway.
# STARKNET_RPC_URLS= is an optional alias for the same list.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/KEY1,https://starknet-mainnet.g.alchemy.com/v2/KEY2

# Optional WebSocket for faster swap alerts. If omitted or it fails, the bot polls HTTP.
STARKNET_WS_URL=

# Optional. Without this, /chart All is capped at ~180 days (Gecko public API).
# Analyst+ CoinGecko key unlocks full pool history like the GeckoTerminal website.
# COINGECKO_API_KEY=

# Optional override for SLAY all-time high (default 0.002019 in code).
# SLAY_ATH_USD=0.002019

# Optional. Origin for /eli NFT images, metadata, and deep links.
# ELI_SITE_ORIGIN=https://brothereli.com

# Optional. Marketplace indexer proxy for NFT list/sold alerts (default {ELI_SITE_ORIGIN}/api/eli-marketplace).
# MARKETPLACE_API_URL=https://brothereli.com/api/eli-marketplace

# Optional. How often to poll marketplace activity (ms, default 15000).
# NFT_ACTIVITY_POLL_MS=15000

# Optional. Your Telegram user id(s). Owners see how many groups the bot is in
# (count only — other groups' names/settings stay hidden unless you are admin).
# BOT_OWNER_IDS=123456789
